diff --git a/src/database/WriteQueue.cpp b/src/database/WriteQueue.cpp
new file mode 100644
index 0000000..efa0003
--- /dev/null
+++ b/src/database/WriteQueue.cpp
@@ -0,0 +1,201 @@
+#include "database/WriteQueue.h"
+
+#include <stdexcept>
+#include <utility>
+
+namespace mgi {
+
+namespace {
+
+// promise 只能 set 一次；任何 fulfillment 异常（future_error）都不得逃出写线程。
+void fulfillValue(std::promise<void>& promise) noexcept {
+    try {
+        promise.set_value();
+    } catch (...) {
+    }
+}
+
+void fulfillException(std::promise<void>& promise, std::exception_ptr error) noexcept {
+    try {
+        promise.set_exception(std::move(error));
+    } catch (...) {
+    }
+}
+
+} // namespace
+
+// ───────────────────────────── 生命周期 ─────────────────────────────
+
+WriteQueue::WriteQueue(IndexDatabase& writer) : writer_(writer) {
+    worker_ = std::thread([this] { workerLoop(); });
+}
+
+WriteQueue::~WriteQueue() {
+    shutdown(/*drainPending=*/true);   // 程序退出/对象销毁：排空队列（D020/M16）
+}
+
+// ───────────────────────────── 提交路径 ─────────────────────────────
+
+std::future<void> WriteQueue::submit(Task task, Priority priority, bool cancellable) {
+    auto item = std::make_shared<Item>();
+    item->id = nextId_.fetch_add(1);
+    item->priority = priority;
+    item->cancellable = cancellable;
+    item->task = std::move(task);
+    return enqueue(std::move(item));
+}
+
+std::future<void> WriteQueue::submitInTransaction(Task task, Priority priority,
+                                                  bool cancellable) {
+    auto item = std::make_shared<Item>();
+    item->id = nextId_.fetch_add(1);
+    item->priority = priority;
+    item->cancellable = cancellable;
+    item->inTransaction = true;
+    item->task = std::move(task);
+    return enqueue(std::move(item));
+}
+
+void WriteQueue::submitAndWait(Task task, Priority priority) {
+    submit(std::move(task), priority).get();   // 异常在调用方线程重抛（错误传给调用方）
+}
+
+std::future<void> WriteQueue::enqueue(std::shared_ptr<Item> item) {
+    std::future<void> future = item->promise->get_future();
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (stopRequested_) {
+            throw std::runtime_error("WriteQueue: 已 shutdown，拒绝新任务 (id=" +
+                                     std::to_string(item->id) + ")");
+        }
+        heap_.push_back(std::move(item));
+        std::push_heap(heap_.begin(), heap_.end(), PendingOrder{});
+    }
+    workCv_.notify_one();
+    return future;
+}
+
+// ───────────────────────────── 取消 / 排空 / 停止 ─────────────────────────────
+
+bool WriteQueue::tryCancel(std::uint64_t taskId) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto& item : heap_) {
+        if (item->id == taskId) {
+            if (!item->cancellable) {
+                return false;   // 未标记 cancellable 的任务不可取消
+            }
+            item->canceled = true;   // 写线程弹出时发现则跳过执行
+            return true;
+        }
+    }
+    return false;   // 不在队列 = 已开始执行/已完成/不存在
+}
+
+void WriteQueue::drain() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    idleCv_.wait(lock, [this] { return heap_.empty() && !busy_; });
+}
+
+void WriteQueue::shutdown(bool drainPending) {
+    std::lock_guard<std::mutex> joinLock(shutdownMutex_);   // 并发/重复 shutdown（含析构）安全
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stopRequested_ = true;      // 幂等：enqueue 从此拒绝新任务
+        drainPending_ = drainPending;
+        accepting_.store(false);
+    }
+    workCv_.notify_all();
+    if (drainPending) {
+        drain();   // 排空：所有已入队任务执行完毕
+    }
+    if (worker_.joinable()) {
+        worker_.join();
+    }
+    // drainPending=false 时未执行的任务已在 workerLoop 退出路径以异常完成
+    // （future.get() 抛 std::runtime_error），不会悬挂调用方。
+}
+
+// ───────────────────────────── 写线程 ─────────────────────────────
+
+bool WriteQueue::PendingOrder::operator()(const std::shared_ptr<Item>& a,
+                                          const std::shared_ptr<Item>& b) const {
+    if (a->priority != b->priority) {
+        return a->priority < b->priority;   // 堆顶 = 优先级最高
+    }
+    return a->id > b->id;   // 同优先级：id 小（先提交）为堆顶 → FIFO
+}
+
+void WriteQueue::workerLoop() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    for (;;) {
+        workCv_.wait(lock, [this] { return stopRequested_ || !heap_.empty(); });
+
+        if (stopRequested_ && (heap_.empty() || !drainPending_)) {
+            // 不排空停止：剩余任务以异常完成，调用方 future.get() 可感知
+            for (auto& item : heap_) {
+                fulfillException(*item->promise, std::make_exception_ptr(
+                    std::runtime_error("WriteQueue: shutdown(drainPending=false)，"
+                                       "任务未执行即被丢弃")));
+            }
+            heap_.clear();
+            idleCv_.notify_all();
+            return;
+        }
+
+        // 取最高优先级（同优先级 FIFO）
+        std::pop_heap(heap_.begin(), heap_.end(), PendingOrder{});
+        std::shared_ptr<Item> item = heap_.back();
+        heap_.pop_back();
+        busy_ = true;
+        lock.unlock();
+
+        runItem(*item);   // 捕获一切异常并写入 promise，写线程永不因任务失败死亡
+
+        lock.lock();
+        busy_ = false;
+        idleCv_.notify_all();
+    }
+}
+
+void WriteQueue::runItem(Item& item) {
+    if (item.canceled) {
+        fulfillValue(*item.promise);   // 取消 = 正常完成（跳过执行）
+        return;
+    }
+
+    // 队列代管事务（submitInTransaction）：BEGIN IMMEDIATE → 任务 → COMMIT。
+    // 若写连接已处于事务中（调用方线程纪律违例），不再嵌套 BEGIN，交由
+    // 下方的回滚安全网兜底——SQLite 无嵌套事务，BEGIN 会直接报错。
+    bool queueBeganTx = false;
+    if (item.inTransaction && !writer_.inTransaction()) {
+        try {
+            writer_.begin();   // BEGIN IMMEDIATE
+            queueBeganTx = true;
+        } catch (...) {
+            fulfillException(*item.promise, std::current_exception());
+            return;
+        }
+    }
+
+    try {
+        item.task();
+        if (queueBeganTx) {
+            writer_.commit();
+        }
+        fulfillValue(*item.promise);
+    } catch (...) {
+        // 失败整体回滚（安全网）：无论事务由队列开启还是任务自管
+        // （ScanService/Matcher 模式），遗留的未决事务一律 ROLLBACK，
+        // 防止"写一半"的数据被后续任务意外提交。回滚自身失败不吞掉原异常。
+        std::exception_ptr error = std::current_exception();
+        try {
+            if (writer_.inTransaction()) {
+                writer_.rollback();
+            }
+        } catch (...) {
+        }
+        fulfillException(*item.promise, std::move(error));
+    }
+}
+
+} // namespace mgi

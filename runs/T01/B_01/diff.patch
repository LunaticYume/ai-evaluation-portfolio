diff --git a/include/database/WriteQueue.h b/include/database/WriteQueue.h
new file mode 100644
index 0000000..086a058
--- /dev/null
+++ b/include/database/WriteQueue.h
@@ -0,0 +1,127 @@
+#pragma once
+
+// WriteQueue — M16 单写者写入队列（D020 组件化；13-ARCHITECTURE A5/§5）。
+//
+// 解决的问题：多个界面/后台流程同时写库时偶发 "database is locked"、
+// 失败后数据"写进去一半"需要手工修复。规则（D020）：
+//   - 所有写操作只经本队列投递，由唯一写线程串行执行（WAL 下读连接不受阻塞）；
+//   - 支持任务优先级（High > Normal > Low，同优先级 FIFO）；
+//   - 排队中（未开始执行）的 cancellable 任务可取消；
+//   - 事务失败整体回滚，异常/错误经 future 传回调用方；
+//   - shutdown(true)/析构时队列排空（程序退出不丢任务）。
+//
+// 线程纪律（调用方约定）：
+//   - 任意线程可 submit / tryCancel / drain / shutdown；
+//   - 任务 lambda 在写线程上执行，经 writer() 访问同一个 IndexDatabase；
+//     队列活跃期间，调用方不得在其他线程直接使用该 IndexDatabase 写库；
+//   - 两条提交路径：
+//       submit()               —— 原样执行任务（任务内部可自管 db.begin/commit，
+//                                 与 ScanService/Matcher 现行事务模式兼容）；
+//       submitInTransaction()  —— 队列代管事务：BEGIN IMMEDIATE → 任务 → COMMIT，
+//                                 任何异常 → ROLLBACK（多语句写必须走这条，保证原子性）；
+//     两条路径失败时都有回滚安全网：任务遗留的未决事务一律 ROLLBACK，
+//     防止"写一半"的数据被后续任务意外提交（对应用户报告的手工修复场景）。
+//
+// 测试证据：tests/test_m16_writequeue.cpp（mgi_tests_m16）。
+
+#include "database/IndexDatabase.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace mgi {
+
+class WriteQueue {
+public:
+    // 任务优先级：数值大的先执行；同优先级按提交顺序（FIFO）。
+    enum class Priority : int { Low = 0, Normal = 1, High = 2 };
+
+    using Task = std::function<void()>;
+
+    // 持有唯一写连接（不转移所有权；生命周期必须覆盖队列）。
+    explicit WriteQueue(IndexDatabase& writer);
+    // RAII 排空：析构 = shutdown(true)——执行完所有排队任务后停线程。
+    ~WriteQueue();
+
+    WriteQueue(const WriteQueue&) = delete;
+    WriteQueue& operator=(const WriteQueue&) = delete;
+
+    // 提交任务（原样执行，不做事务包装）。
+    // 返回 future：任务抛出的异常在 future.get()/submitAndWait 处重抛（错误传给调用方）。
+    // cancellable=true 时，任务未开始前可被 tryCancel 取消（取消 = future 正常完成，跳过执行）。
+    std::future<void> submit(Task task, Priority priority = Priority::Normal,
+                             bool cancellable = false);
+
+    // 提交并在队列代管的事务中执行：BEGIN IMMEDIATE → task() → COMMIT；
+    // task() 或 COMMIT 抛异常 → ROLLBACK，异常经 future 传回（整体回滚语义）。
+    std::future<void> submitInTransaction(Task task, Priority priority = Priority::Normal,
+                                          bool cancellable = false);
+
+    // 提交并阻塞等待完成；任务异常在此重抛。多个线程可并发调用。
+    void submitAndWait(Task task, Priority priority = Priority::Normal);
+
+    // 写连接：任务在写线程上执行时经此访问数据库（D020 单写者纪律）。
+    IndexDatabase& writer() { return writer_; }
+
+    // 取消排队中的任务（仅 cancellable 且未开始执行的可取消）。
+    // 返回 true = 已取消（不会执行）；false = 已开始/已完成/不存在/不可取消。
+    bool tryCancel(std::uint64_t taskId);
+
+    // 测试钩子：下一个 submit 将分配的任务 id（id 从 1 起单调递增）。
+    std::uint64_t nextIdForTest() const { return nextId_.load(); }
+
+    // 阻塞等待：所有已入队任务执行完毕（队列空且写线程空闲）。
+    void drain();
+
+    // 停止接收新任务（此后 submit 抛 std::runtime_error）。
+    //   drainPending=true ：先执行完所有排队任务再停止（程序退出用；析构等价）；
+    //   drainPending=false：立即停止，未执行任务以异常完成（future.get() 抛出）。
+    void shutdown(bool drainPending);
+
+    // 当前是否已停止接收新任务（诊断用）。
+    bool isShuttingDown() const { return !accepting_.load(); }
+
+private:
+    struct Item {
+        std::uint64_t id{0};
+        Priority priority{Priority::Normal};
+        bool cancellable{false};
+        bool canceled{false};        // tryCancel 置位；弹出时发现则跳过执行
+        bool inTransaction{false};   // submitInTransaction 置位（队列代管事务）
+        std::shared_ptr<std::promise<void>> promise{std::make_shared<std::promise<void>>()};
+        Task task;
+    };
+    // 堆序：优先级高者优先；同优先级 id 小者（先提交）优先。
+    struct PendingOrder {
+        bool operator()(const std::shared_ptr<Item>& a,
+                        const std::shared_ptr<Item>& b) const;
+    };
+
+    std::future<void> enqueue(std::shared_ptr<Item> item);
+    void workerLoop();
+    void runItem(Item& item);   // 永不向线程外抛异常
+
+    IndexDatabase& writer_;
+    std::thread worker_;
+
+    mutable std::mutex mutex_;
+    std::mutex shutdownMutex_;          // shutdown 串行化（并发/析构重复调用安全）
+    std::condition_variable workCv_;    // 唤醒写线程（新任务 / 停止）
+    std::condition_variable idleCv_;    // drain 等待（队列空且写线程空闲）
+    std::vector<std::shared_ptr<Item>> heap_;   // pending 堆（push_heap/pop_heap）
+
+    std::atomic<std::uint64_t> nextId_{1};
+    std::atomic<bool> accepting_{true};
+    bool busy_{false};             // 写线程正在执行任务（mutex_ 保护）
+    bool stopRequested_{false};    // shutdown 已调用（mutex_ 保护）
+    bool drainPending_{false};     // stop 前是否排空（mutex_ 保护）
+};
+
+} // namespace mgi

diff --git a/tests/repro_scan_idempotency.cpp b/tests/repro_scan_idempotency.cpp
new file mode 100644
index 0000000..bc38eff
--- /dev/null
+++ b/tests/repro_scan_idempotency.cpp
@@ -0,0 +1,102 @@
+// repro_scan_idempotency — 复现用户报告：同一目录扫描两次，第二次结果与第一次不一致。
+// 用法:
+//   repro_scan_idempotency init    — 建目录树 + 新库 + 第一次扫描（退出，保留 DB 供外部快照）
+//   repro_scan_idempotency rescan  — 打开既有库，第二次扫描（不重建目录树）
+//   repro_scan_idempotency all     — 一次进程内连扫两次并对比（快速冒烟）
+#include "database/IndexDatabase.h"
+#include "scanner/ScanService.h"
+#include "status/StateEngine.h"
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace fs = std::filesystem;
+using namespace mgi;
+
+static const fs::path kBase =
+    fs::temp_directory_path() / "mgi_repro_idem";
+static const fs::path kRoot = kBase / "music";
+static const fs::path kDb = kBase / "repro.db";
+
+static void writeFile(const fs::path& path, const std::string& content) {
+    fs::create_directories(path.parent_path());
+    std::ofstream stream(path, std::ios::binary);
+    stream << content;
+}
+
+static void buildTree() {
+    std::error_code ec;
+    fs::remove_all(kBase, ec);
+    fs::create_directories(kBase);
+    writeFile(kRoot / "Album X" / "01 - a.flac", "content-alpha-0001");
+    writeFile(kRoot / "Album X" / "02 - b.flac", "content-beta-0000002");
+    writeFile(kRoot / "Album X" / "disc1" / "03 - c.flac", "content-gamma-0003");
+    writeFile(kRoot / "Album X" / "disc2" / "04 - c.flac", "content-delta-0004");
+    writeFile(kRoot / "Album Y" / "05 - a.flac", "content-alpha-0001");
+    writeFile(kRoot / "Album Y" / "06 - e.flac", "x");
+    writeFile(kRoot / "top.flac", "content-top-00000000006");
+}
+
+static void printOutcome(const char* tag, const ScanOutcome& o) {
+    std::cout << tag << ": filesAdded=" << o.filesAdded
+              << " filesRemoved=" << o.filesRemoved
+              << " filesChanged=" << o.filesChanged
+              << " filesMoved=" << o.filesMoved
+              << " filesRenamed=" << o.filesRenamed
+              << " foldersAdded=" << o.foldersAdded
+              << " foldersRemoved=" << o.foldersRemoved
+              << " foldersRenamed=" << o.foldersRenamed
+              << " recordingsCreated=" << o.recordingsCreated
+              << " hashesComputed=" << o.hashesComputed
+              << " errors=" << o.errors << "\n";
+}
+
+struct Deps {
+    IndexDatabase db;
+    StateEngine engine;
+    MetadataReader reader;
+    ScanService scanner;
+    explicit Deps(bool migrate)
+        : db(kDb), engine(db), reader(), scanner(db, engine, reader) {
+        if (migrate) db.migrate();
+    }
+};
+
+static int runScan(Deps& d, const char* tag) {
+    const auto o = d.scanner.scanRoot(kRoot, "repro");
+    printOutcome(tag, o);
+    int eventCount = 0;
+    for (const auto& e : d.db.recentEvents(o.sessionId, 10000)) {
+        std::cout << "  EVENT: " << e.type << " " << e.path << "\n";
+        ++eventCount;
+    }
+    if (eventCount == 0) std::cout << "  EVENT: (none)\n";
+    return eventCount;
+}
+
+int main(int argc, char** argv) {
+    const std::string mode = argc > 1 ? argv[1] : "all";
+
+    if (mode == "init" || mode == "all") {
+        buildTree();
+        Deps d(/*migrate=*/true);
+        runScan(d, "SCAN1");
+        if (mode == "init") return 0; // 退出，保留现场给外部快照
+        const int events2 = runScan(d, "SCAN2");
+        if (events2 != 0) {
+            std::cout << "IDEMPOTENCY: FAILED (second scan emitted events)\n";
+            return 1;
+        }
+        std::cout << "IDEMPOTENCY: PASS\n";
+        return 0;
+    }
+
+    // rescan：复用既有库与目录树
+    Deps d(/*migrate=*/false);
+    return runScan(d, "SCAN2") == 0 ? 0 : 1;
+}
diff --git a/tests/repro_scan_paths.cpp b/tests/repro_scan_paths.cpp
new file mode 100644
index 0000000..8f21b98
--- /dev/null
+++ b/tests/repro_scan_paths.cpp
@@ -0,0 +1,106 @@
+// repro_scan_paths — 回归测试（R104 扫描幂等）：用同一物理目录的不同路径拼写连续扫描，
+// 断言永远命中同一个 scan_root 且重扫零变化；并覆盖"历史库中已存混合大小写 path 行"的兼容。
+// 退出码 0 = 全部断言通过。
+#include "database/IndexDatabase.h"
+#include "scanner/ScanService.h"
+#include "status/StateEngine.h"
+
+#include <cctype>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <vector>
+
+namespace fs = std::filesystem;
+using namespace mgi;
+
+static void writeFile(const fs::path& path, const std::string& content) {
+    fs::create_directories(path.parent_path());
+    std::ofstream stream(path, std::ios::binary);
+    stream << content;
+}
+
+int main() {
+    const fs::path base = fs::temp_directory_path() / "mgi_repro_paths";
+    std::error_code ec;
+    fs::remove_all(base, ec);
+    fs::create_directories(base);
+    const fs::path root = base / "Music";
+    writeFile(root / "Album" / "01 - a.flac", "content-a");
+    writeFile(root / "Album" / "02 - b.flac", "content-b");
+
+    IndexDatabase db(base / "paths.db");
+    StateEngine engine(db);
+    MetadataReader reader;
+    ScanService scanner(db, engine, reader);
+    db.migrate();
+
+    // 同一目录的多种拼写（Windows 现实中用户/对话框会给出这些变体）
+    std::vector<fs::path> spellings;
+    spellings.push_back(root);                           // 常规
+    spellings.push_back(root / "");                      // 尾部分隔符
+    spellings.push_back(fs::path(root.string() + "\\")); // 反斜杠尾
+    spellings.push_back(base / "." / "Music");           // 内嵌 "."
+    spellings.push_back(base / "Sub" / ".." / "Music");  // 内嵌 ".."
+    {   // 大小写变体（同盘同目录）
+        std::string s = root.string();
+        const std::size_t pos = s.find_last_of("/\\");
+        std::string last = s.substr(pos + 1);
+        for (char& c : last) {
+            c = static_cast<char>(std::islower(static_cast<unsigned char>(c))
+                                      ? std::toupper(static_cast<unsigned char>(c))
+                                      : std::tolower(static_cast<unsigned char>(c)));
+        }
+        spellings.push_back(fs::path(s.substr(0, pos + 1) + last));
+    }
+
+    std::vector<ScanOutcome> results;
+    for (std::size_t i = 0; i < spellings.size(); ++i) {
+        results.push_back(scanner.scanRoot(spellings[i], "variant"));
+        std::cout << "scan[" << i << "] input=\"" << spellings[i].string()
+                  << "\" -> rootId=" << results.back().scanRootId
+                  << " filesAdded=" << results.back().filesAdded
+                  << " filesRemoved=" << results.back().filesRemoved << "\n";
+    }
+
+    // ── 旧库兼容：历史版本可能已存有混合大小写的 scan_root.path ──
+    const fs::path legacyDir = base / "Legacy";
+    writeFile(legacyDir / "01 - l.flac", "content-l");
+    db.execRaw("INSERT INTO scan_root(path, label) VALUES('" +
+               (base / "LEGACY").generic_string() + "', 'legacy-simulated-old-row')");
+    const auto legacyScan1 = scanner.scanRoot(legacyDir, "legacy");
+    std::cout << "legacy scan1 -> rootId=" << legacyScan1.scanRootId
+              << " filesAdded=" << legacyScan1.filesAdded << "\n";
+    const auto legacyScan2 = scanner.scanRoot(legacyDir, "legacy");
+    std::cout << "legacy scan2 -> rootId=" << legacyScan2.scanRootId
+              << " filesAdded=" << legacyScan2.filesAdded << "\n";
+    // 用大小写不同的拼写再扫：若 NOCASE 命中失效会生成新 rootId（断言捕获）
+    const auto legacyScan3 = scanner.scanRoot(base / "LEGACY", "legacy");
+    std::cout << "legacy scan3(case-variant) -> rootId=" << legacyScan3.scanRootId
+              << " filesAdded=" << legacyScan3.filesAdded << "\n";
+
+    // ── 断言 ──
+    int failures = 0;
+    const auto check = [&](bool cond, const char* what) {
+        if (!cond) {
+            std::cout << "  FAIL: " << what << "\n";
+            ++failures;
+        }
+    };
+    for (std::size_t i = 1; i < spellings.size(); ++i) {
+        check(results[i].scanRootId == results[0].scanRootId,
+              "all spellings resolve to the same scan root");
+        check(results[i].filesAdded == 0 && results[i].filesRemoved == 0,
+              "rescan with variant spelling is a no-op");
+    }
+    check(results[0].filesAdded == 2, "first scan adds its files once");
+    check(legacyScan1.filesAdded == 1, "legacy root first scan adds its files once");
+    check(legacyScan2.scanRootId == legacyScan1.scanRootId && legacyScan2.filesAdded == 0,
+          "legacy root rescan is a no-op");
+    check(legacyScan3.scanRootId == legacyScan1.scanRootId && legacyScan3.filesAdded == 0,
+          "legacy root case-variant rescan reuses the same row (NOCASE hit)");
+
+    std::cout << (failures == 0 ? "PATH-IDEMPOTENCY: ALL PASS" : "PATH-IDEMPOTENCY: FAILED")
+              << " (" << failures << " failures)\n";
+    return failures == 0 ? 0 : 1;
+}

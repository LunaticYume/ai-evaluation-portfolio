+// Windows 文件系统大小写不敏感，同一目录的不同大小写拼写（"Music" vs "mUSIC"）
+// 若不折叠，会生成两个 scan_root，重扫时全部文件被当作新增再次入库。
+// 仅折叠 ASCII 字母：不触碰 >=0x80 的字节，避免破坏 UTF-8 多字节序列；
+// 非 Windows 平台路径大小写敏感，保持原样。
+std::string foldRootKeyCase(std::string key) {
+#ifdef _WIN32
+    for (char& ch : key) {
+        const unsigned char uc = static_cast<unsigned char>(ch);
+        if (uc >= 'A' && uc <= 'Z') {
+            ch = static_cast<char>(uc - 'A' + 'a');
+        }
+    }
+#else
+    (void)key;
+#endif
+    return key;
+}

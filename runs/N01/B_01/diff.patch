+// ── T-SCAN-08：mtime 整秒量化抖动不产生幻影事件（09 §4 幂等） ──
+// MinGW/libstdc++ 的 directory_entry::last_write_time 存在 floor/round 不稳定的整秒
+// 量化：同一未改动文件的 mtime 两次读取可相差 ±1000ms。回归覆盖：
+//   1) 同 size、mtime 微移（±1s）→ 无 CHANGED 事件、计数全零、重扫收敛；
+//   2) 文件夹重命名 + 内部文件 mtime 微移 → 签名对账仍识别为 FOLDER_RENAMED，
+//      不降级为增删（降级会把完好文件送进移动候选池、被误配）。
+void testScanMtimeJitterIdempotent() {
+    std::cout << "[T-SCAN-08] mtime jitter tolerated, rescan stays clean\n";
+    Case test("mtime_jitter");
+
+    // 1) 文件级：mtime 微移
+    const auto filePath = test.root / "album" / "01 - song.flac";
+    writeFile(filePath, "audio-bytes");
+    test.scanner.scanRoot(test.root);
+
+    const auto bumped = fs::last_write_time(filePath) + std::chrono::milliseconds(1000);
+    fs::last_write_time(filePath, bumped);
+
+    const auto second = test.scanner.scanRoot(test.root);
+    CHECK(second.rootAvailable);
+    CHECK(second.filesChanged == 0);
+    CHECK(second.filesAdded == 0 && second.filesRemoved == 0);
+    CHECK(second.filesMoved == 0 && second.filesRenamed == 0);
+    CHECK(test.database.countEvents(second.sessionId) == 0); // 抖动静默对齐，零事件
+
+    const auto third = test.scanner.scanRoot(test.root); // 重扫收敛
+    CHECK(third.filesChanged == 0 && third.filesAdded == 0 && third.filesRemoved == 0);
+    CHECK(test.database.countEvents(third.sessionId) == 0);
+
+    // 2) 文件夹级：重命名 + 内部文件 mtime 微移
+    writeFile(test.root / "Album Old" / "a.flac", "bytes-a");
+    writeFile(test.root / "Album Old" / "b.flac", "bytes-b");
+    const auto first = test.scanner.scanRoot(test.root);
+    CHECK(first.filesAdded == 2);
+
+    const auto folderBefore = test.database.findFolderByRel(first.scanRootId, "Album Old");
+    CHECK(folderBefore.has_value());
+
